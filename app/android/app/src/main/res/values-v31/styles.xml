<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts: deep green with the chit card in the middle,
         in light and dark mode alike, so there is no white flash. Removed
         when Flutter draws its first frame, the app's own loading screen,
         which starts from the same picture. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/kuree_deep</item>
        <item name="android:navigationBarColor">@color/kuree_deep</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- Android 12 and later draw their own splash: deep green, and the
             card as the icon. Only the middle circle of the icon shows, and
             the card sits inside it (tools/brand/splash.py). No icon
             background, so the icon keeps its full 288dp size. -->
        <item name="android:windowSplashScreenBackground">@color/kuree_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash</item>
    </style>
    <!-- Behind the Flutter UI once the process has started: the same deep
         green, so nothing flashes between the launch screen and the app. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kuree_deep</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
